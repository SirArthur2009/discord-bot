DISCORD_TOKEN=put_your_bot_token_here
# Optional multi-server configuration. Copy servers.example.json to servers.json,
# fill in each server's IDs, then uncomment this line. It overrides GUILD_ID,
# COMMAND_ROLE_ID, GITHUB_CHANNEL_ID, and GITHUB_REPO below.
# SERVER_CONFIG_PATH=servers.json
# Optional. Put your test server ID here for instant slash-command syncing.
# Leave blank for global commands.
GUILD_ID=123456789012345678

# Required. Only members with this role can run /claim commands.
COMMAND_ROLE_ID=123456789012345678

# Optional. Useful on Railway if you mount a persistent volume.
# DB_PATH=/data/claims.db

# Optional GitHub integration. Leave all three values blank to keep only /claim.
# Fine-grained token: Issues and Pull requests read/write.
GITHUB_TOKEN=
GITHUB_CHANNEL_ID=
GITHUB_WEBHOOK_SECRET=
# Default repository is this project's GitHub remote.
GITHUB_REPO=SirArthur2009/discord-bot
# Railway sets PORT automatically; locally the webhook server uses 8080.
# PORT=8080

# Optional GitHub App sign-in. Enable Device Flow, keep user token expiration on,
# and install the app only on the configured repository with Issues/PR read/write.
GITHUB_APP_CLIENT_ID=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and secret; it encrypts user credentials in the database.
GITHUB_AUTH_ENCRYPTION_KEY=
